{
  "name": "parimatch-betting-india",
  "private": true,
  "description": "Static HTML site about Parimatch for India, served by Cloudflare Workers static assets",
  "scripts": {
    "build": "python3 build.py",
    "dev": "python3 build.py && node serve.mjs 8090",
    "deploy": "python3 build.py && sh scripts/cf.sh deploy",
    "validate": "python3 build.py && html-validate \"public/**/*.html\"",
    "og": "python3 tools/make_og.py",
    "cf": "sh scripts/cf.sh",
    "login": "sh scripts/cf.sh login",
    "whoami": "sh scripts/cf.sh whoami"
  },
  "devDependencies": {
    "html-validate": "^9.7.1"
  }
}
